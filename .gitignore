# Secrets never live in this tree — RevenueCat public keys, the AdMob app/unit
# ids and the upload keystore come from ~/.config/nanti/ via env vars.
.env
.env.*
!.env.example

node_modules/
dist/
coverage/
.DS_Store

# Expo / React Native — generated by `expo prebuild`, never committed.
.expo/
android/
ios/
*.tsbuildinfo
*.apk
*.aab

.eslintcache
.prettiercache

# Coverage / CI artefacts
coverage/
