# Copy to .env (gitignored). Public SDK keys only — never a secret key.
EXPO_PUBLIC_RC_TEST_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_STORE=TEST
# The real rewarded unit `settle_rewarded` (SSV → https://api.revenuecat.com/v1/incoming-webhooks/admob-ssv-rewarded).
# Unset → Google's sample unit: ads play, verification correctly FAILS, the tab stays.
EXPO_PUBLIC_ADMOB_REWARDED_UNIT=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# Read at prebuild time by app.config.ts:
NANTI_ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~zzzzzzzzzz
