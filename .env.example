# Copy to .env (gitignored). PUBLIC keys and ids only — never a secret key.
# Every value is sourced from ~/.config/nanti/secrets.env on the build machine.

# ── RevenueCat ───────────────────────────────────────────────
# Get from: https://app.revenuecat.com → Project "Nanti" → Apps → Test Store → Public API key
EXPO_PUBLIC_RC_TEST_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxx
# Get from: https://app.revenuecat.com → Project "Nanti" → Apps → Google Play (dev.edycu.nanti) → Public API key
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
# TEST (dev build, instant no-charge purchases) or GOOGLE (release AAB). eas.json sets it per profile.
EXPO_PUBLIC_RC_STORE=TEST

# ── AdMob ────────────────────────────────────────────────────
# Get from: https://apps.admob.com → Apps → Nanti (Android) → Ad units → settle_rewarded (Rewarded)
# The unit MUST have Server-side verification ON with callback
#   https://api.revenuecat.com/v1/incoming-webhooks/admob-ssv-rewarded
# Used by RELEASE builds only. Dev builds (__DEV__) always request Google's test rewarded unit
# (AdMob policy). Test unit / unset → ads play, verification correctly FAILS, the tab stays.
EXPO_PUBLIC_ADMOB_REWARDED_UNIT=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
# Get from: https://apps.admob.com → Apps → Nanti (Android) → App settings → App ID
# Read at PREBUILD time by app.config.ts (not at runtime). Unset → Google's sample app id.
NANTI_ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~zzzzzzzzzz

# ── Release signing (prebuild-time, read by plugins/withReleaseSigning.js) ──
# Generate once: keytool -genkeypair -v -storetype PKCS12 -keystore ~/.config/nanti/upload-keystore.jks \
#   -alias nanti -keyalg RSA -keysize 4096 -validity 10000
# NANTI_KEYSTORE_PATH=/Users/you/.config/nanti/upload-keystore.jks
# NANTI_KEYSTORE_ALIAS=nanti
# NANTI_KEYSTORE_PASSWORD=change-me
