{
  "name": "nanti",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "description": "The letter now. The ad later. Formal Indonesian letters as a PDF in under a minute; one rewarded ad owed afterwards, settled by RevenueCat \u2014 or cleared for good with Pro.",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "golden": "tsx scripts/gen-golden.ts",
    "bench": "tsx scripts/bench.ts",
    "verify:offline": "tsx scripts/verify_offline.ts",
    "settle-log": "tsx scripts/settle-log-export.ts",
    "readiness": "node scripts/check_submission_readiness.js",
    "ablation": "node scripts/ablation.js",
    "bundle:check": "expo export --platform android --output-dir dist --clear >/dev/null && node scripts/bundle-check.js",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run bench && npm run verify:offline && npm run ablation && npm run readiness",
    "ios": "expo run:ios",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=lcov --coverage.include='packages/**' --coverage.include='src/ledger/tab.ts' --coverage.include='src/ads/settleState.ts' --coverage.include='src/i18n/**' --coverage.thresholds.100",
    "audit": "npm audit --audit-level=high",
    "secrets": "gitleaks git --no-banner --redact .",
    "ci:full": "npm run ci && npm run bundle:check",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-purchases": "^10.9.1",
    "react-native-purchases-ui": "^10.9.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/react": "~19.1.10",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
