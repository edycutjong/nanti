{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleDebug" },
      "env": { "EXPO_PUBLIC_RC_STORE": "TEST" }
    },
    "internal": {
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_RC_STORE": "GOOGLE" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": "versionCode",
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_RC_STORE": "GOOGLE" }
    }
  },
  "submit": { "production": { "android": { "track": "internal", "releaseStatus": "draft" } } }
}
